<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Group: ActivityKit (not the shared container) carries all Live
	     Activity state, and keeping the widget group-free avoids a needless
	     App ID capability on free personal teams. Add it back only if a later
	     phase actually reads shared session state from the widget. -->
</dict>
</plist>
