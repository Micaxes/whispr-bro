ggml-metal: park the residency heartbeat once keep-alive expires

llama.cpp b9862 starts a background "heartbeat" thread per Metal device
(ggml_metal_rsets_init) that loops forever on usleep(time_per_loop_ms *
1000) = 5 ms. The keep-alive window (GGML_METAL_RESIDENCY_KEEP_ALIVE_S,
180 s by default) only gates whether each pass calls requestResidency;
once it has run out the thread still wakes 200 times a second, and it
keeps doing so after the backend has been freed. An idle process pays
~140-165 wakeups/s for the rest of its life.

The thread now sleeps on a dispatch semaphore once the window is over.
ggml_metal_device_rsets_keep_alive(), which every graph compute already
calls, re-arms it; ggml_metal_rsets_free() signals it so a parked thread
can see d_stop and exit.

Applies to b9862 and to upstream master. Local to whispr-bro until it is
upstreamed; applied by scripts/build-llama-xcframework.sh.

diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index a7cbc60..83216ac 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -554,6 +554,10 @@ void ggml_metal_encoder_end_encoding(ggml_metal_encoder_t encoder) {
     atomic_bool d_stop;
     atomic_int  d_loop;
 
+    // parks the heartbeat once keep_alive_s has run out, so an idle process
+    // stops waking every time_per_loop_ms; keep_alive() / free() signal it
+    dispatch_semaphore_t d_wake;
+
     dispatch_group_t d_group;
 };
 
@@ -583,6 +587,7 @@ ggml_metal_rsets_t ggml_metal_rsets_init(void) {
     atomic_store_explicit(&res->d_stop, false, memory_order_relaxed);
     atomic_store_explicit(&res->d_loop, res->loops_per_s*res->keep_alive_s, memory_order_relaxed);
 
+    res->d_wake  = dispatch_semaphore_create(0);
     res->d_group = dispatch_group_create();
 
     // start a background thread that periodically requests residency for all the currently active sets in the collection
@@ -602,9 +607,12 @@ ggml_metal_rsets_t ggml_metal_rsets_init(void) {
                       atomic_fetch_sub_explicit(&res->d_loop, 1, memory_order_relaxed);
 
                       [res->lock unlock];
-                  }
 
-                  usleep(res->time_per_loop_ms * 1000);
+                      usleep(res->time_per_loop_ms * 1000);
+                  } else {
+                      // keep-alive window over: sleep until re-armed instead of polling forever
+                      dispatch_semaphore_wait(res->d_wake, DISPATCH_TIME_FOREVER);
+                  }
               }
         }
 #endif
@@ -622,9 +630,11 @@ void ggml_metal_rsets_free(ggml_metal_rsets_t rsets) {
     GGML_ASSERT([rsets->data count] == 0);
 
     atomic_store_explicit(&rsets->d_stop, true, memory_order_relaxed);
+    dispatch_semaphore_signal(rsets->d_wake); // unpark an idle heartbeat so it can see d_stop
 
     dispatch_group_wait(rsets->d_group, DISPATCH_TIME_FOREVER);
     dispatch_release(rsets->d_group);
+    dispatch_release(rsets->d_wake);
 
     [rsets->data release];
     [rsets->lock release];
@@ -983,7 +993,10 @@ void ggml_metal_device_rsets_keep_alive(ggml_metal_device_t dev) {
         return;
     }
 
-    atomic_store_explicit(&dev->rsets->d_loop, dev->rsets->loops_per_s*dev->rsets->keep_alive_s, memory_order_relaxed);
+    const int prev = atomic_exchange_explicit(&dev->rsets->d_loop, dev->rsets->loops_per_s*dev->rsets->keep_alive_s, memory_order_relaxed);
+    if (prev <= 0) {
+        dispatch_semaphore_signal(dev->rsets->d_wake); // wake a parked heartbeat
+    }
 }
 
 struct ggml_metal_event {
